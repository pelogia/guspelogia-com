---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SpeakingEvents from '../components/SpeakingEvents.astro';
import photo1 from '../assets/pages/public-speaking/photo-1.jpg';
import photo2 from '../assets/pages/public-speaking/photo-2.jpg';
import photo3 from '../assets/pages/public-speaking/photo-3.jpg';

const title = 'SEO Public Speaker | Gus Pelogia';
const description =
	'Gus Pelogia speaks on SEO, product management and search at conferences and meetups across Europe.';

const videos = [
	{ id: '41oZez-O3Mk', title: 'Vibe Code Your Own SEO Tools With LLMs | Whiteboard Friday | Gus Pelogia' },
	{ id: 'KTEtucpA3IE', title: 'SEO Use Cases for Vector Embeddings - Gus Pelogia | SnS Antalya 2025' },
	{
		id: 'FVwFC4T8jOQ',
		title: 'How to write THE perfect SEO ticket for your devs - Gus Pelogia - brightonSEO April 2024',
	},
	{
		id: 'dFRNVJHd9n0',
		title: 'How to Use MCP Servers for SEO: Practical Use Cases - Gus Pelogia - BrightonSEO Spring 2026',
	},
	{
		id: 'DMPqnozRCvc',
		title: 'Think like a product manager: optimize beyond SEO - Gus Pelogia - brightonSEO September 2023',
	},
	{ id: 'GyvMPVN7Kf4', title: 'Product Mindset for Better SEO | Gus Pelogia | Whiteboard Friday' },
	{
		id: 'PT3u8qGC2aE',
		title: 'Wolfgang Essentials 2019 - Winning The Battle Against OTAs in Organic Search Results',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={photo2} />
	</head>
	<body>
		<Header />
		<main class="prose">
			<span class="eyebrow">Looking for an SEO speaker?</span>
			<h1>Public Speaking</h1>
			<hr class="rule" />
			<p>
				Gus Pelogia started his public speaking journey in 2018, inspired by the SEO professionals
				he admired and a desire to step outside his comfort zone. Despite working for agencies at
				the time, he went on a tour of regional SEO meet ups across the UK and paid costs from his
				pocket. There wasn't necessarily "business" to be made, other than get some stage
				experience and make industry friends. What began as a personal challenge quickly became
				one of the most rewarding parts of his career.
			</p>
			<p>
				From intimate meetups with 40 attendees to large conferences with audiences up to 1000,
				Gus brings the same enthusiasm for sharing knowledge and helping other SEOs grow.
			</p>
			<p>
				His speaking experience includes international events such as BrightonSEO, Search 'n
				Stuff, LondonSEOXL and SMX Advanced Europe. His talks cover technical SEO, enterprise SEO,
				product thinking and the practical application of AI and emerging technologies in search.
			</p>
			<p>
				Gus believes the best talks give people something they can put into practice straight
				away, regardless of their experience level. He adapts each presentation to the event, the
				audience and their challenges, making sure attendees leave with actionable insights rather
				than just theory.
			</p>
			<p>
				Over the years, he has spoken at in-person events across Ireland, UK, Netherlands,
				Germany, Croatia, Italy and Turkey.
			</p>

			<ul class="gallery">
				<li><Image src={photo1} alt="Gus Pelogia speaking at a conference" width={480} height={324} /></li>
				<li><Image src={photo2} alt="Gus Pelogia on stage at a conference" width={480} height={324} /></li>
				<li><Image src={photo3} alt="Gus Pelogia presenting to an audience" width={480} height={324} /></li>
			</ul>

			<h2>Where I've spoken</h2>
			<SpeakingEvents />

			<h2>See Gus in action</h2>
			<ul class="video-grid">
				{
					videos.map((video) => (
						<li>
							<iframe
								width="100%"
								height="220"
								src={`https://www.youtube.com/embed/${video.id}`}
								title={video.title}
								loading="lazy"
								allowfullscreen
							/>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.prose {
		width: 1100px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
	.rule {
		margin: 1.5rem 0 2rem;
	}
	.gallery {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		list-style: none;
		padding: 0;
		margin: 2rem 0;
	}
	.gallery img {
		border: 1px solid rgb(var(--line));
		width: 100%;
		max-width: 300px;
		height: auto;
	}
	.video-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		list-style: none;
		padding: 0;
	}
	.video-grid iframe {
		border: 1px solid rgb(var(--line));
	}
</style>

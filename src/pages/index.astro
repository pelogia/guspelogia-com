---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SpeakingEvents from '../components/SpeakingEvents.astro';
import { SITE_DESCRIPTION } from '../consts';

const pageTitle = 'Gus Pelogia | SEO Product Manager & Speaker';
import portrait from '../assets/pages/home/gus-portrait.jpg';
import heroStage from '../assets/pages/home/hero-stage.jpg';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} image={portrait} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<div class="hero-media">
					<Image
						src={heroStage}
						alt="Gus Pelogia speaking on stage at brightonSEO"
						width={1800}
						height={1000}
					/>
					<div class="hero-scrim"></div>
				</div>
				<div class="hero-copy">
					<span class="eyebrow">SEO Product Manager at Indeed</span>
					<h1>Gus Pelogia</h1>
					<ul class="social-bar">
						<li><a href="https://www.linkedin.com/in/gpelogia/">LinkedIn ↗</a></li>
					</ul>
				</div>
			</section>

			<hr class="rule" />

			<section class="bio ticked">
				<span class="eyebrow">About</span>
				<p>
					Gus Pelogia is a journalist turned SEO and Product Manager, working in digital growth
					since 2011.
				</p>
				<p>
					He currently works as an SEO Product Manager at Indeed, the world's #1 job site,
					helping drive organic growth and build experiences that connect people with
					opportunities. Gus also organizes SearchIRL, an SEO meetup held in Dublin since 2025,
					with seven events so far.
				</p>
				<p>
					Throughout his career, Gus has worked with cross-functional teams, led organic growth
					initiatives and contributed to award-winning campaigns recognised by The Drum Search
					Awards and the Irish Content Marketing Awards. In 2026, he won an individual award at
					SEO Camp, using his public persona as a use case for career growth.
				</p>
				<p>
					He has also been a judge for the EU Search Awards since 2021 and spoken at
					international industry events, including BrightonSEO (4x), SMX Advanced Europe, Search
					'n Stuff, SEO Brein, Tech SEO Summit and many more.
				</p>
				<p>
					Before moving into SEO, Gus graduated in Journalism from Faculdade Cásper Líbero in
					2009 and worked for some of Brazil's biggest entertainment media outlets, including
					MTV, Terra and R7. He is also the author of two books in Portuguese, <em>Diário de
						Palco</em> and <em>Vomitando em Portunhol</em>, both rooted in Brazil's punk,
					hardcore and emo music scenes.
				</p>
			</section>

			<hr class="rule" />

			<section class="speaking">
				<span class="eyebrow">Public speaking</span>
				<p>Gus speaks at conferences and meetups across Europe on SEO and product management.</p>
				<p><a href="/public-speaking">See the full list, photos and talk recordings →</a></p>
				<SpeakingEvents />
			</section>

			<hr class="rule" />

			<section class="podcasts">
				<span class="eyebrow">Podcasts</span>
				<p>
					I've been invited as a guest to several SEO and digital marketing podcasts, such as The
					SEO Sprint, SEOSLY, Majestic SEO and more.
				</p>
				<iframe
					class="spotify-embed"
					data-testid="embed-iframe"
					src="https://open.spotify.com/embed/playlist/1F3IcgldYZPkc1r68pegfy?utm_source=generator&si=afa3f32ce0e04578"
					width="100%"
					height="352"
					allowfullscreen
					allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
					loading="lazy"
				></iframe>
				<p>
					<a href="https://open.spotify.com/playlist/1F3IcgldYZPkc1r68pegfy"
						>Listen to the full playlist on Spotify ↗</a
					>
				</p>
			</section>

			<hr class="rule" />

			<section class="recent-posts">
				<span class="eyebrow">Recent writing</span>
				<ol>
					{
						recentPosts.map((post, i) => (
							<li>
								<a href={`/${post.id}`}>
									<span class="num">{String(i + 1).padStart(2, '0')}</span>
									<span class="title">{post.data.title}</span>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))
					}
				</ol>
				<p><a href="/blog">See all posts →</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: 1100px;
	}
	.hero {
		position: relative;
		width: 100vw;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		min-height: 60vh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
	}
	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}
	.hero-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 25%;
		filter: grayscale(20%) contrast(1.05);
		opacity: 0.3;
	}
	.hero-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(14, 16, 18, 0) 25%, rgba(14, 16, 18, 0.88) 100%);
	}
	.hero-copy {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 1100px;
		margin: 0 auto;
		padding: 2rem 1.5rem 3rem;
	}
	.hero-copy .eyebrow {
		color: rgba(255, 255, 255, 0.75);
	}
	.hero-copy h1 {
		font-size: clamp(3rem, 8vw, 6rem);
		margin: 0;
		color: #fff;
	}
	.hero-copy .social-bar a {
		color: rgba(255, 255, 255, 0.85);
	}
	.hero-copy .social-bar a:hover {
		color: var(--accent);
	}
	.social-bar {
		display: flex;
		gap: 1.5rem;
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
	}
	.social-bar a {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}
	.social-bar a:hover {
		color: var(--accent);
	}
	.bio,
	.podcasts,
	.speaking,
	.recent-posts {
		padding: 2.5rem 0;
	}
	.spotify-embed {
		display: block;
		width: 100%;
		border: 0;
		border-radius: 12px;
		margin: 1.5rem 0;
	}
	.bio {
		padding-left: 1.5rem;
	}
	.recent-posts ol {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5em;
	}
	.recent-posts li {
		border-bottom: 1px solid rgb(var(--line));
	}
	.recent-posts li a {
		display: grid;
		grid-template-columns: 3rem 1fr auto;
		align-items: baseline;
		gap: 1rem;
		padding: 1em 0.25em;
		text-decoration: none;
		color: inherit;
	}
	.recent-posts li a:hover .title {
		color: var(--accent);
	}
	.recent-posts .num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	.recent-posts .title {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1.05rem;
		color: rgb(var(--ink));
	}
	.recent-posts .date {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	@media (max-width: 640px) {
		.social-bar {
			justify-content: center;
		}
		.hero-copy h1 {
			font-size: clamp(2.25rem, 12vw, 3.5rem);
		}
	}
</style>

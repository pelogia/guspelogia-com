<script define:vars={{ highlighted }}>
	document
		.querySelectorAll('.europe-map > path, .europe-map > g')
		.forEach((el) => {
			if (highlighted.includes(el.id)) el.classList.add('highlighted');
		});
</script>

<style>
	.europe-map {
		width: 100%;
		height: auto;
		display: block;
	}
	.europe-map :global(path),
	.europe-map :global(g) {
		fill: rgb(var(--line));
		stroke: rgb(var(--paper));
		stroke-width: 0.6;
		transition: fill 0.15s ease;
	}
	.europe-map :global(.highlighted) {
		fill: var(--accent);
	}
	.europe-map :global(.highlighted path) {
		fill: var(--accent);
	}
</style>

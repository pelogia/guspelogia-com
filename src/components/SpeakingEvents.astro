---
import EuropeMap from './EuropeMap.astro';

const countriesSpoken = ['ie', 'gb', 'de', 'tr', 'hr', 'nl', 'it', 'no'];

const years = [
	{
		year: '2025',
		events: [
			{ city: 'Oslo, NO', name: 'Performancekonf' },
			{ city: 'Hamburg, DE', name: 'Tech SEO Summit' },
			{ city: 'Zagreb, CR', name: 'Zagreb SEO' },
			{ city: 'Manchester, UK', name: 'Up North' },
			{ city: 'Munich, DE', name: 'SEO Weisn' },
			{ city: "Antalya, TR", name: "Search 'n Stuff" },
			{ city: 'Amsterdam, NL', name: 'Spotlight' },
		],
	},
	{
		year: '2026',
		events: [
			{ city: 'Rotterdam, NL', name: 'SEO Brein' },
			{ city: 'Brighton, UK', name: 'BrightonSEO' },
			{ city: 'Manchester, UK', name: 'HiveMCR' },
			{ city: 'Šibenik, CR', name: 'Croatia SEO Summit' },
			{ city: 'Berlin, DE', name: 'Campixxx' },
			{ city: 'Berlin, DE', name: 'SMX Advanced' },
			{ city: 'Brighton, UK', name: 'BrightonSEO' },
			{ city: 'Zagreb, CR', name: 'Zagreb SEO Day' },
		],
	},
	{
		year: '2027',
		events: [{ city: 'Amsterdam, NL', name: 'Friends of Search' }],
	},
];
---

<div class="speaking-events">
	<div class="map-wrap">
		<EuropeMap highlighted={countriesSpoken} />
		<p class="map-caption">
			Countries spoken in: Ireland, UK, Germany, Turkey, Croatia, Netherlands, Italy, Norway
		</p>
	</div>

	<p class="carousel-hint" aria-hidden="true">← Swipe to see other years →</p>

	<div class="years" id="years-track">
		{
			years.map(({ year, events }) => (
				<div class="year-group" data-year={year}>
					<span class="year-label">{year}</span>
					<ul>
						{events.map((event) => (
							<li>
								<span class="city">{event.city}</span>
								<span class="name">{event.name}</span>
								<span class="dot" aria-hidden="true" />
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>

	<div class="year-dots" aria-hidden="true">
		{
			years.map(({ year }) => (
				<button type="button" class="year-dot" data-year={year} aria-label={`Show ${year}`} />
			))
		}
	</div>
</div>

<script>
	const track = document.getElementById('years-track');
	const groups = track ? Array.from(track.querySelectorAll('.year-group')) : [];
	const dots = Array.from(document.querySelectorAll('.year-dot'));

	if (track && groups.length && dots.length) {
		const setActive = (year: string | undefined) => {
			dots.forEach((dot) => {
				dot.classList.toggle('active', dot.getAttribute('data-year') === year);
			});
		};

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter((entry) => entry.isIntersecting)
					.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
				if (visible) {
					setActive((visible.target as HTMLElement).dataset.year);
				}
			},
			{ root: track, threshold: [0.5, 0.75] }
		);
		groups.forEach((group) => observer.observe(group));

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				const year = dot.getAttribute('data-year');
				const target = groups.find((group) => (group as HTMLElement).dataset.year === year);
				target?.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
			});
		});
	}
</script>

<style>
	.speaking-events {
		display: grid;
		gap: 2.5rem;
	}
	.map-wrap {
		max-width: 520px;
		margin: 0 auto;
	}
	.map-caption {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: rgb(var(--gray));
		text-align: center;
		margin: 0.75rem 0 0;
	}
	.carousel-hint {
		display: none;
	}
	.year-dots {
		display: none;
	}
	.years {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
		border: 1px solid rgb(var(--line));
	}
	.year-group {
		border-left: 1px solid rgb(var(--line));
		min-width: 0;
	}
	.year-group:first-child {
		border-left: none;
	}
	.year-group:nth-child(1) {
		order: 3;
	}
	.year-group:nth-child(2) {
		order: 2;
	}
	.year-group:nth-child(3) {
		order: 1;
	}
	.year-label {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--accent);
		letter-spacing: 0.04em;
		padding: 1rem 1.25rem 0.5rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0 1.25rem 0.5rem;
	}
	li {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 0.6rem 0;
		border-top: 1px solid rgb(var(--line));
	}
	li:first-child {
		border-top: none;
	}
	.city {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: rgb(var(--gray));
		min-width: 9rem;
		flex-shrink: 0;
	}
	.name {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1rem;
		color: rgb(var(--ink));
		flex: 1;
	}
	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		flex-shrink: 0;
	}
	@media (max-width: 760px) {
		.carousel-hint {
			display: block;
			text-align: center;
			font-family: var(--font-mono);
			font-size: 0.75rem;
			color: var(--accent);
			letter-spacing: 0.04em;
			margin: 0 0 0.75rem;
			animation: carousel-hint-nudge 2.2s ease-in-out infinite;
		}
		.years {
			display: flex;
			gap: 0.75rem;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-padding-left: 1rem;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			border: none;
			padding: 0.25rem 1rem 0.5rem;
			margin: 0 -1rem;
		}
		.years::-webkit-scrollbar {
			display: none;
		}
		.year-group {
			flex: 0 0 85%;
			scroll-snap-align: start;
			border: 1px solid rgb(var(--line));
			border-radius: 4px;
			background: rgb(var(--paper));
		}
		.year-dots {
			display: flex;
			justify-content: center;
			gap: 0.5rem;
			margin-top: 1rem;
		}
		.year-dot {
			width: 8px;
			height: 8px;
			padding: 0;
			border-radius: 50%;
			border: 1px solid rgb(var(--line));
			background: rgb(var(--paper));
			cursor: pointer;
		}
		.year-dot.active {
			background: var(--accent);
			border-color: var(--accent);
		}
	}
	@keyframes carousel-hint-nudge {
		0%,
		100% {
			opacity: 0.6;
			transform: translateX(0);
		}
		50% {
			opacity: 1;
			transform: translateX(3px);
		}
	}
	@media (max-width: 560px) {
		li {
			flex-wrap: wrap;
		}
		.city {
			min-width: 0;
			width: 100%;
		}
	}
</style>

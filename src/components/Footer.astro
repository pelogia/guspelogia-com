---
const today = new Date();
---

<footer>
	<div class="inner">
		<span class="eyebrow">§ connect</span>
		<div class="row">
			<p class="copyright">© {today.getFullYear()} Gus Pelogia</p>
			<div class="social-links">
				<a href="https://www.linkedin.com/in/gpelogia/" target="_blank" rel="noopener">LinkedIn</a>
				<a href="https://open.spotify.com/playlist/1F3IcgldYZPkc1r68pegfy" target="_blank" rel="noopener"
					>Spotify</a
				>
			</div>
		</div>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid rgb(var(--line));
		padding: 2em 1em 4em;
		margin-top: 3em;
	}
	.inner {
		max-width: 1100px;
		margin: 0 auto;
	}
	.row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.75em;
	}
	.copyright {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	.social-links {
		display: flex;
		gap: 1.5em;
	}
	.social-links a {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}
	.social-links a:hover {
		color: var(--accent);
	}
</style>

---
import { SITE_TITLE } from '../consts';

const navItems = [
	{ href: '/searchirl', label: 'SearchIRL', icon: 'pin' },
	{ href: '/public-speaking', label: 'Public Speaking', icon: 'mic' },
	{ href: '/blog', label: 'Blog', icon: 'doc' },
];
const toolItems = [
	{ href: '/sweetspot', label: 'Sweetspot (Traffic & Revenue)' },
	{ href: '/user-agent-bulk-checker', label: 'User Agent Bulk Checker' },
	{ href: '/knowledge-panel-tracker', label: 'Entity Tracker' },
];
const ICONS: Record<string, string> = {
	pin: '<path d="M12 21s-7-5.686-7-11a7 7 0 1 1 14 0c0 5.314-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
	mic: '<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="8" y1="22" x2="16" y2="22"/>',
	doc: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/>',
	tools: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-6 6a2 2 0 1 0 2.9 2.8l6-5.9a4 4 0 0 0 5.4-5.4l-2.8 2.7-2-2z"/>',
};
const pathname = new URL(Astro.request.url).pathname;
const isActive = (href: string) => pathname === href || pathname === `${href}/`;
---

<header>
	<nav id="site-nav">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="header-controls">
			<div class="social-links">
				<a href="https://www.linkedin.com/in/gpelogia/" target="_blank" rel="noopener">
					<span class="sr-only">Gus Pelogia on LinkedIn</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="#0A66C2"
							fill-rule="evenodd"
							d="M13.5 0h-11A2.5 2.5 0 0 0 0 2.5v11A2.5 2.5 0 0 0 2.5 16h11a2.5 2.5 0 0 0 2.5-2.5v-11A2.5 2.5 0 0 0 13.5 0zM4.94 13.5H2.68V6.2h2.26v7.3zM3.81 5.2a1.31 1.31 0 1 1 0-2.62 1.31 1.31 0 0 1 0 2.62zM13.5 13.5h-2.25V9.98c0-.84-.3-1.41-1.05-1.41-.57 0-.91.39-1.06.76-.05.13-.07.32-.07.5v3.67H6.82s.03-5.95 0-7.3h2.25v1.03a2.24 2.24 0 0 1 2.03-1.12c1.48 0 2.4.97 2.4 3.06v4.33z"
						></path>
					</svg>
				</a>
				<a href="https://open.spotify.com/playlist/1F3IcgldYZPkc1r68pegfy" target="_blank" rel="noopener">
					<span class="sr-only">Gus Pelogia's podcast appearances on Spotify</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="#1DB954"
							fill-rule="evenodd"
							d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm3.67 11.55a.5.5 0 0 1-.69.17c-1.9-1.16-4.29-1.42-7.1-.78a.5.5 0 0 1-.22-.98c3.08-.7 5.72-.4 7.85.92a.5.5 0 0 1 .16.67zm.98-2.18a.62.62 0 0 1-.85.2c-2.17-1.33-5.48-1.72-8.05-.94a.62.62 0 1 1-.36-1.19c2.93-.89 6.58-.46 9.07 1.07a.62.62 0 0 1 .19.86zm.09-2.27C10.3 5.6 5.76 5.45 3.1 6.26a.74.74 0 1 1-.43-1.42c3.06-.93 8.12-.75 11.32 1.17a.74.74 0 0 1-.76 1.27z"
						></path>
					</svg>
				</a>
				<a
					href="https://www.youtube.com/watch?v=41oZez-O3Mk&list=PLbvzol8diTRc"
					target="_blank"
					rel="noopener"
				>
					<span class="sr-only">Gus Pelogia on YouTube</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="#FF0000"
							d="M15.8 4.4s-.16-1.1-.63-1.59c-.6-.63-1.27-.63-1.58-.67C11.35 2 8 2 8 2h0s-3.35 0-5.59.14c-.31.04-.98.04-1.58.67C.36 3.3.2 4.4.2 4.4S0 5.68 0 6.96v1.21c0 1.28.2 2.56.2 2.56s.16 1.1.63 1.59c.6.63 1.39.6 1.74.67C3.89 13.1 8 13.14 8 13.14s3.35 0 5.59-.14c.31-.04.98-.04 1.58-.67.47-.49.63-1.59.63-1.59s.2-1.28.2-2.56V6.96c0-1.28-.2-2.56-.2-2.56z"
						></path>
						<path fill="#fff" d="M6.4 9.9V5.4l4.2 2.25z"></path>
					</svg>
				</a>
			</div>
		</div>
		<div class="nav-panel" id="nav-panel">
			<div class="internal-links">
				{
					navItems.map((item) => (
						<a href={item.href} class:list={[{ active: isActive(item.href) }]}>
							<span class="nav-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[item.icon]}</svg>`} />
							<span class="nav-label">{item.label}</span>
						</a>
					))
				}
				<details class="seo-tools">
					<summary>
						<span class="nav-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS.tools}</svg>`} />
						<span class="nav-label">SEO Tools</span>
					</summary>
					<ul>
						{
							toolItems.map((item) => (
								<li>
									<a href={item.href}>{item.label}</a>
								</li>
							))
						}
					</ul>
				</details>
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		background: rgb(var(--paper));
		border-bottom: 1px solid rgb(var(--line));
		position: sticky;
		top: 0;
		z-index: 20;
	}
	nav {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 1.5rem;
		width: 100%;
		margin: 0;
		padding: 0 1.5rem;
	}
	.brand {
		order: 0;
		flex-shrink: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.43rem;
		color: rgb(var(--ink));
		text-decoration: none;
		text-align: left;
		margin: 0;
		padding: 1em 0;
		white-space: nowrap;
	}
	.nav-panel {
		order: 1;
		margin-left: auto;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 1.5rem;
		min-width: 0;
	}
	.header-controls {
		order: 2;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 1.25rem;
		flex-shrink: 0;
		margin-left: auto;
	}
	.internal-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1.4em 0.6em;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 1.17rem;
		font-weight: 500;
	}
	nav a.active {
		color: var(--accent);
	}
	nav a:hover {
		color: var(--accent);
	}
	.seo-tools {
		position: relative;
		display: inline-block;
	}
	.seo-tools summary {
		padding: 1.4em 0.6em;
		cursor: pointer;
		list-style: none;
		font-size: 1.17rem;
		font-weight: 500;
		color: rgb(var(--gray-dark));
	}
	.seo-tools summary::-webkit-details-marker {
		display: none;
	}
	.seo-tools[open] summary {
		color: var(--accent);
	}
	.seo-tools ul {
		position: absolute;
		top: 100%;
		left: 0;
		margin: 0;
		padding: 0.5em 0;
		list-style: none;
		background: rgb(var(--paper));
		border: 1px solid rgb(var(--line));
		box-shadow: var(--box-shadow);
		min-width: 240px;
		z-index: 10;
	}
	.seo-tools li a {
		display: block;
		padding: 0.6em 1em;
		white-space: nowrap;
		font-size: 1.1rem;
	}
	.social-links {
		display: flex;
		gap: 1em;
		flex-shrink: 0;
		color: rgb(var(--gray-dark));
	}
	.social-links a {
		padding: 0;
		display: flex;
		opacity: 1;
		transition: opacity 0.15s ease;
	}
	.social-links a:hover {
		opacity: 0.75;
	}
	.nav-icon {
		display: none;
	}
	.nav-icon svg {
		width: 100%;
		height: 100%;
	}

	@media (max-width: 760px) {
		.brand {
			font-size: 1.716rem;
			margin-right: auto;
		}
		.nav-panel {
			display: flex;
			position: fixed;
			top: auto;
			bottom: 0;
			left: 0;
			right: 0;
			flex-direction: row;
			align-items: stretch;
			gap: 0;
			background: rgb(var(--paper));
			border-top: 1px solid rgb(var(--line));
			box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.12);
			padding-bottom: env(safe-area-inset-bottom);
			z-index: 25;
		}
		.internal-links {
			flex-direction: row;
			align-items: stretch;
			width: 100%;
		}
		nav a {
			flex: 1;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: flex-start;
			gap: 0.25rem;
			padding: 0.65em 0.25em 0.5em;
			font-size: 0.82rem;
			text-align: center;
		}
		.nav-icon {
			display: inline-flex;
			width: 26px;
			height: 26px;
			flex-shrink: 0;
		}
		.seo-tools {
			flex: 1;
			display: flex;
			border-bottom: none;
		}
		.seo-tools summary {
			flex: 1;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: flex-start;
			gap: 0.25rem;
			padding: 0.65em 0.25em 0.5em;
			font-size: 0.82rem;
			text-align: center;
		}
		.seo-tools ul {
			position: fixed;
			top: auto;
			bottom: calc(90px + env(safe-area-inset-bottom));
			left: 0;
			right: 0;
			border: none;
			border-top: 1px solid rgb(var(--line));
			box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.12);
			background: rgb(var(--paper));
			padding: 0.5em 0;
			min-width: 0;
		}
		.seo-tools li a {
			flex-direction: row;
			justify-content: flex-start;
			width: 100%;
			padding: 0.75em 1.25em;
			border-bottom: 1px solid rgb(var(--line));
			font-size: 0.9rem;
			text-align: left;
		}
		.seo-tools li:last-child a {
			border-bottom: none;
		}
		.social-links {
			gap: 1em;
		}
	}
</style>

<style is:global>
	@media (max-width: 760px) {
		body {
			padding-bottom: calc(90px + env(safe-area-inset-bottom));
		}
	}
</style>

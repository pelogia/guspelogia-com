---
import { SITE_TITLE } from '../consts';

const navItems = [
	{ href: '/searchirl', label: 'SearchIRL' },
	{ href: '/public-speaking', label: 'Public Speaking' },
	{ href: '/blog', label: 'Blog' },
];
const toolItems = [
	{ href: '/sweetspot', label: 'Sweetspot (Traffic & Revenue)' },
	{ href: '/user-agent-bulk-checker', label: 'User Agent Bulk Checker' },
	{ href: '/knowledge-panel-tracker', label: 'Entity Tracker' },
];
const pathname = new URL(Astro.request.url).pathname;
const isActive = (href: string) => pathname === href || pathname === `${href}/`;
---

<header>
	<nav id="site-nav">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="header-controls">
			<div class="social-links">
				<a href="https://www.linkedin.com/in/gpelogia/" target="_blank" rel="noopener">
					<span class="sr-only">Gus Pelogia on LinkedIn</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="#0A66C2"
							fill-rule="evenodd"
							d="M13.5 0h-11A2.5 2.5 0 0 0 0 2.5v11A2.5 2.5 0 0 0 2.5 16h11a2.5 2.5 0 0 0 2.5-2.5v-11A2.5 2.5 0 0 0 13.5 0zM4.94 13.5H2.68V6.2h2.26v7.3zM3.81 5.2a1.31 1.31 0 1 1 0-2.62 1.31 1.31 0 0 1 0 2.62zM13.5 13.5h-2.25V9.98c0-.84-.3-1.41-1.05-1.41-.57 0-.91.39-1.06.76-.05.13-.07.32-.07.5v3.67H6.82s.03-5.95 0-7.3h2.25v1.03a2.24 2.24 0 0 1 2.03-1.12c1.48 0 2.4.97 2.4 3.06v4.33z"
						></path>
					</svg>
				</a>
				<a href="https://open.spotify.com/playlist/1F3IcgldYZPkc1r68pegfy" target="_blank" rel="noopener">
					<span class="sr-only">Gus Pelogia's podcast appearances on Spotify</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="#1DB954"
							fill-rule="evenodd"
							d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm3.67 11.55a.5.5 0 0 1-.69.17c-1.9-1.16-4.29-1.42-7.1-.78a.5.5 0 0 1-.22-.98c3.08-.7 5.72-.4 7.85.92a.5.5 0 0 1 .16.67zm.98-2.18a.62.62 0 0 1-.85.2c-2.17-1.33-5.48-1.72-8.05-.94a.62.62 0 1 1-.36-1.19c2.93-.89 6.58-.46 9.07 1.07a.62.62 0 0 1 .19.86zm.09-2.27C10.3 5.6 5.76 5.45 3.1 6.26a.74.74 0 1 1-.43-1.42c3.06-.93 8.12-.75 11.32 1.17a.74.74 0 0 1-.76 1.27z"
						></path>
					</svg>
				</a>
				<a
					href="https://www.youtube.com/watch?v=41oZez-O3Mk&list=PLbvzol8diTRc"
					target="_blank"
					rel="noopener"
				>
					<span class="sr-only">Gus Pelogia on YouTube</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="#FF0000"
							d="M15.8 4.4s-.16-1.1-.63-1.59c-.6-.63-1.27-.63-1.58-.67C11.35 2 8 2 8 2h0s-3.35 0-5.59.14c-.31.04-.98.04-1.58.67C.36 3.3.2 4.4.2 4.4S0 5.68 0 6.96v1.21c0 1.28.2 2.56.2 2.56s.16 1.1.63 1.59c.6.63 1.39.6 1.74.67C3.89 13.1 8 13.14 8 13.14s3.35 0 5.59-.14c.31-.04.98-.04 1.58-.67.47-.49.63-1.59.63-1.59s.2-1.28.2-2.56V6.96c0-1.28-.2-2.56-.2-2.56z"
						></path>
						<path fill="#fff" d="M6.4 9.9V5.4l4.2 2.25z"></path>
					</svg>
				</a>
			</div>
			<button
				class="menu-toggle"
				id="menu-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="nav-panel"
				aria-label="Toggle menu"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
		<div class="nav-panel" id="nav-panel">
			<div class="internal-links">
				{
					navItems.map((item) => (
						<a href={item.href} class:list={[{ active: isActive(item.href) }]}>
							{item.label}
						</a>
					))
				}
				<details class="seo-tools">
					<summary>SEO Tools</summary>
					<ul>
						{
							toolItems.map((item) => (
								<li>
									<a href={item.href}>{item.label}</a>
								</li>
							))
						}
					</ul>
				</details>
			</div>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const nav = document.getElementById('site-nav');

	if (toggle && nav) {
		toggle.addEventListener('click', () => {
			const isOpen = nav.classList.toggle('open');
			toggle.setAttribute('aria-expanded', String(isOpen));
			document.body.classList.toggle('nav-lock', isOpen);
		});

		nav.querySelectorAll('.nav-panel a').forEach((link) => {
			link.addEventListener('click', () => {
				nav.classList.remove('open');
				toggle.setAttribute('aria-expanded', 'false');
				document.body.classList.remove('nav-lock');
			});
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && nav.classList.contains('open')) {
				nav.classList.remove('open');
				toggle.setAttribute('aria-expanded', 'false');
				document.body.classList.remove('nav-lock');
			}
		});
	}
</script>

<style>
	header {
		background: rgb(var(--paper));
		border-bottom: 1px solid rgb(var(--line));
		position: sticky;
		top: 0;
		z-index: 20;
	}
	nav {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1.5rem;
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1em;
	}
	.brand {
		order: 0;
		flex-shrink: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.1rem;
		color: rgb(var(--ink));
		text-decoration: none;
		padding: 1em 0;
		white-space: nowrap;
	}
	.nav-panel {
		order: 1;
		margin-left: auto;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 1.5rem;
		min-width: 0;
	}
	.header-controls {
		order: 2;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 1.25rem;
		flex-shrink: 0;
		margin-left: auto;
	}
	.internal-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1.4em 0.6em;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
	}
	nav a.active {
		color: var(--accent);
	}
	nav a:hover {
		color: var(--accent);
	}
	.seo-tools {
		position: relative;
		display: inline-block;
	}
	.seo-tools summary {
		padding: 1.4em 0.6em;
		cursor: pointer;
		list-style: none;
		font-size: 0.9rem;
		font-weight: 500;
		color: rgb(var(--gray-dark));
	}
	.seo-tools summary::-webkit-details-marker {
		display: none;
	}
	.seo-tools[open] summary {
		color: var(--accent);
	}
	.seo-tools ul {
		position: absolute;
		top: 100%;
		left: 0;
		margin: 0;
		padding: 0.5em 0;
		list-style: none;
		background: rgb(var(--paper));
		border: 1px solid rgb(var(--line));
		box-shadow: var(--box-shadow);
		min-width: 240px;
		z-index: 10;
	}
	.seo-tools li a {
		display: block;
		padding: 0.6em 1em;
		white-space: nowrap;
		font-size: 0.85rem;
	}
	.social-links {
		display: flex;
		gap: 1em;
		flex-shrink: 0;
		color: rgb(var(--gray-dark));
	}
	.social-links a {
		padding: 0;
		display: flex;
		opacity: 1;
		transition: opacity 0.15s ease;
	}
	.social-links a:hover {
		opacity: 0.75;
	}
	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		flex-shrink: 0;
	}
	.menu-toggle span {
		display: block;
		width: 22px;
		height: 2px;
		background: rgb(var(--ink));
		border-radius: 1px;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}
	nav.open .menu-toggle span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	nav.open .menu-toggle span:nth-child(2) {
		opacity: 0;
	}
	nav.open .menu-toggle span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	@media (max-width: 760px) {
		.menu-toggle {
			display: flex;
		}
		.nav-panel {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			max-height: calc(100vh - 100%);
			overflow-y: auto;
			background: rgb(var(--paper));
			border-bottom: 1px solid rgb(var(--line));
			box-shadow: var(--box-shadow);
		}
		nav.open .nav-panel {
			display: flex;
		}
		.internal-links {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
		}
		nav a {
			padding: 0.9em 1.25em;
			border-bottom: 1px solid rgb(var(--line));
			font-size: 1rem;
		}
		.seo-tools {
			display: block;
			border-bottom: 1px solid rgb(var(--line));
		}
		.seo-tools summary {
			padding: 0.9em 1.25em;
			font-size: 1rem;
		}
		.seo-tools ul {
			position: static;
			border: none;
			box-shadow: none;
			background: rgba(var(--ink), 3%);
			padding: 0;
			min-width: 0;
		}
		.seo-tools li a {
			padding: 0.75em 1.25em 0.75em 2.25em;
			border-bottom: 1px solid rgb(var(--line));
		}
		.seo-tools li:last-child a {
			border-bottom: none;
		}
		.social-links {
			gap: 1em;
		}
	}
</style>

<style is:global>
	body.nav-lock {
		overflow: hidden;
	}
</style>
